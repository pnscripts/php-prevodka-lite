{
    "name": "pnscripts/prevodka-lite",
    "description": "SEPA credit transfer files (ISO 20022 pain.001.001.09) from PHP: IBAN and BIC checks, Bulgarian transliteration and the SEPA character set, exact control sums in cents, messages in English and Bulgarian.",
    "type": "library",
    "license": "MIT",
    "keywords": ["sepa", "pain.001", "iso20022", "credit transfer", "iban", "bulgaria", "transliteration"],
    "homepage": "https://pnscripts.com/marketplace/php-prevodka",
    "authors": [
        {"name": "PN Scripts", "email": "office@pnscripts.com", "homepage": "https://pnscripts.com"}
    ],
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {"psr-4": {"PNScripts\\PrevodkaLite\\": "src/"}},
    "autoload-dev": {"psr-4": {"PNScripts\\PrevodkaLite\\Tests\\": "tests/"}},
    "config": {"sort-packages": true},
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "issues": "https://github.com/pnscripts/php-prevodka-lite/issues",
        "source": "https://github.com/pnscripts/php-prevodka-lite",
        "email": "office@pnscripts.com"
    }
}
